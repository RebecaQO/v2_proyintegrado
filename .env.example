# ── NVIDIA NIM (LLMs) ──────────────────────────────────────────────────────
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_CREW=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MODEL_NVIDIA=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# ── Agente de Consistencia Normativa (embeddings + pgvector sobre Neon) ────
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_DIM=2048
PROFESIONAL_SIMILITUD_MINIMA=0.15
LLM_MODEL_CONSISTENCIA=nvidia/nemotron-3.5-lightning-30b-a3b
UMBRAL_CONSISTENCIA=0.55
TOP_K_CONSISTENCIA=8

# ── MongoDB Atlas ───────────────────────────────────────────────────────────
# Reemplaza con tu cadena de conexión de MongoDB Atlas
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/sma_congreso?retryWrites=true&w=majority
MONGO_DB=sma_congreso

# ── PostgreSQL Neon (datos legales / constitución) ─────────────────────────
NEON_DATABASE_URL=postgresql://neondb_owner:npg_TS9hwLya2sMo@ep-blue-mode-axz3v893-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Google Drive OAuth2 ────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_SECRETS=client_secrets.json
GOOGLE_DRIVE_TOKEN_FILE=token.json
GOOGLE_DRIVE_FOLDER_ID=1bJc0BO9IlzIm3zPeJV2t0ICrp1yTK7C4

# ── Sistema ─────────────────────────────────────────────────────────────────
AGENTE_VERSION=2.0.0
MAX_REINTENTOS=3
TIMEOUT_LLM_SEG=120

# ── Perfiles de modelo por rol de agente (fuente oficial) ───────────────────
# El YAML declara el PERFL por agente; base_agent.py lo resuelve a estas variables.
LLM_MODELO_RAZONAMIENTO=nvidia/nemotron-3-ultra-550b-a55b
LLM_MODELO_DETERMINISTA=openai/gpt-oss-20b
LLM_MODELO_NORMATIVO=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MODELO_CONVERSACIONAL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
